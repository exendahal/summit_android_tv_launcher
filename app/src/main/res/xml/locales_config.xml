<?xml version="1.0" encoding="utf-8"?>
<!-- Languages the app offers. The other values-* folders are translated but not offered yet;
     to enable one, add it here, to SettingsFragment.LANG_CODES and to the "languages" array (same order). -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ne" />
    <locale android:name="hi" />
    <locale android:name="zh-Hans" />
</locale-config>
