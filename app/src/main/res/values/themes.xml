    <!-- Type scale (PRD 5.3, sp = design px / 2) -->
    <style name="Himal" />
    <style name="Himal.Clock">
        <item name="android:textSize">64sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Himal.Headline">
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Himal.Title">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Himal.BodyLarge">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Himal.Body">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Himal.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/hMuted</item>
    </style>
    <style name="Himal.Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
