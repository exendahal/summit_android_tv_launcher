    <!-- High contrast (PRD 11): secondary text becomes primary text, glass becomes solid. -->
    <style name="ThemeOverlay.Himal.Contrast.Dark" parent="">
        <item name="colorOnSurfaceVariant">@color/dark_text</item>
        <item name="hMuted">@color/dark_text</item>
        <item name="hGlass">@color/dark_surface</item>
    </style>
    <style name="ThemeOverlay.Himal.Contrast.Light" parent="">
        <item name="colorOnSurfaceVariant">@color/light_text</item>
        <item name="hMuted">@color/light_text</item>
        <item name="hGlass">@color/light_surface</item>
    </style>

