<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:clipChildren="false" android:clipToPadding="false"
    android:paddingStart="@dimen/pad_h" android:paddingEnd="@dimen/pad_h"
    android:paddingTop="@dimen/pad_v" android:paddingBottom="@dimen/pad_v"
    android:background="?attr/hTint">

    <include layout="@layout/header_home" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="14dp" android:orientation="horizontal" android:clipChildren="false">

        <!-- One list at a time (categories, options, values); the frame clips it while it slides between levels. -->
        <FrameLayout android:layout_width="400dp" android:layout_height="match_parent" android:clipChildren="true">
        <LinearLayout android:id="@+id/list_pane" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:paddingTop="12dp"
            android:paddingStart="6dp" android:paddingEnd="6dp">
            <TextView android:id="@+id/list_crumb" style="@style/Himal.Caption"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp"
                android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/list_title" style="@style/Himal.Headline" android:textSize="22sp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp"
                android:paddingBottom="6dp" android:singleLine="true" android:ellipsize="end" />
            <ScrollView android:id="@+id/list_scroll" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:scrollbars="none" android:clipToPadding="false" android:padding="4dp"
                android:requiresFadingEdge="vertical" android:fadingEdgeLength="56dp">
                <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginStart="20dp" android:orientation="vertical">
            <TextView style="@style/Himal.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/preview" />
            <FrameLayout android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="210dp"
                android:layout_marginTop="6dp" android:background="@drawable/bg_card" android:clipToOutline="true"
                android:descendantFocusability="blocksDescendants" android:importantForAccessibility="noHideDescendants">
                <ImageView android:id="@+id/pv_wallpaper" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
                <View android:id="@+id/pv_tint" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="?attr/hTint" />
            </FrameLayout>
            <TextView style="@style/Himal.Caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/settings_hint" />        </LinearLayout>
    </LinearLayout>
</LinearLayout>
