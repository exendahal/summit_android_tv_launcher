<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/watch_w" android:layout_height="@dimen/watch_h"
    android:layout_marginEnd="@dimen/tile_gap" android:focusable="true" android:clickable="true"
    app:cardBackgroundColor="?attr/colorPrimaryContainer" app:cardElevation="0dp"
    app:cardCornerRadius="@dimen/r_watch" app:strokeColor="?attr/colorOnSurface" app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp">
        <FrameLayout android:layout_width="@dimen/cookie" android:layout_height="@dimen/cookie">
            <View android:id="@+id/cookie" android:layout_width="match_parent" android:layout_height="match_parent" />
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                android:src="@drawable/ic_live_tv" app:tint="?attr/colorOnPrimary" android:importantForAccessibility="no" />
        </FrameLayout>
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/title" style="@style/Himal.Headline" android:textColor="?attr/colorOnPrimaryContainer"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/watch_tv" />
        <TextView android:id="@+id/sub" style="@style/Himal.Body" android:textColor="?attr/colorOnPrimaryContainer"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
