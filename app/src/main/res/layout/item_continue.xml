<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/continue_w" android:layout_height="@dimen/watch_h"
    android:layout_marginEnd="@dimen/tile_gap" android:focusable="true" android:clickable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainer" app:cardElevation="0dp"
    app:cardCornerRadius="@dimen/r_continue" app:strokeColor="?attr/colorOnSurface" app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="12dp">
        <ImageView android:id="@+id/icon" android:layout_width="@dimen/cookie" android:layout_height="@dimen/cookie"
            android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/title" style="@style/Himal.BodyLarge" android:fontFamily="sans-serif-medium"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/sub" style="@style/Himal.Caption"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
