<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV settings row: flat when idle, solid inverse highlight when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="@integer/anim_row_fade" android:exitFadeDuration="@integer/anim_row_fade">
    <item android:state_focused="true">
        <shape><corners android:radius="@dimen/r_pref_row" /><solid android:color="?attr/colorOnSurface" /></shape>
    </item>
    <item><shape><corners android:radius="@dimen/r_pref_row" /><solid android:color="@android:color/transparent" /></shape></item>
</selector>
